# ==============================================================================
# RestaurantOS — Environment Variable Configuration Template
# Classification: Enterprise SaaS Security Configuration
# SECURITY NOTICE: Never commit real production secrets or API keys to git!
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000/api/v1/realtime

# Database & Cache (PostgreSQL 16+ & Redis 7+)
DATABASE_URL=postgresql://restaurant_user:change_in_production@localhost:5432/restaurant_os?sslmode=prefer
REDIS_URL=redis://localhost:6379

# Cryptographic Keys & JWT Secrets (Minimum 256-bit entropy required)
JWT_SECRET=change_to_a_secure_random_at_least_32_chars_long_secret_key!
SESSION_SECRET=change_to_a_secure_session_encryption_secret_key_32_chars!

# Security & Rate Limiting Controls
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
REALTIME_TICKET_TTL_SECONDS=60

# Telemetry & Retention Controls (PHASE 00 Section 42)
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_ENFORCE_SHIFT_CHECK=true

# External Integration Secrets (Webhooks & Gateways)
WOLT_WEBHOOK_SECRET=test_wolt_webhook_secret_key
TENBIS_WEBHOOK_SECRET=test_tenbis_webhook_secret_key
CIBUS_WEBHOOK_SECRET=test_cibus_webhook_secret_key

# Payment Gateways (PCI-DSS Tokenized APIs - NO raw card data)
MESHULAM_API_KEY=test_meshulam_key
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Telephony / PBX Trunk Credentials (Phase 7 / Israeli Wiretap Compliance)
TELEPHONY_PBX_TOKEN=test_pbx_bearer_token
TELEPHONY_WEBHOOK_SECRET=test_telephony_secret
